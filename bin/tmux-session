# vim: set ft=zsh :

tsess_dir() {
	echo "${XDG_CONFIG_HOME:-$HOME/.config}/tsess/sessions"
}

tsess() {
	local command="$1"

	case $command in
		init)
			mkdir -p $(dirname $(tsess_dir))
			touch $(tsess_dir)
			;;
		add)
			tsess_add "$@"
			;;
		remove)
			tsess_remove "$@"
			;;
		""|attach)
			tsess_attach "$@"
			;;
		help)
			tsess_help
			;;
		*)
			tsess_attach "$@"
			;;
	esac
}

tsess_add() {
	local name="$2"
	local dir="$3"

	if [[ -z "$name" || -z "$dir" ]]; then
		echo "Usage: tsess add <name> <dir>"
		tsess_help
		return 1
	fi

	dir=${~dir}
	dir=${dir:A}
	dir="~${dir#$HOME}"

	echo "$name	$dir" >> "$(tsess_dir)"
	echo "Session '$name' added to '$(tsess_dir)'"
}

tsess_remove() {
	local name="$2"

	if [[ -z "$name" ]]; then
		echo "Usage: tsess remove <name>"
		tsess_help
		return 1
	fi

	sed -i '' "/^$name	/d" "$(tsess_dir)"
	echo "Session '$name' removed from '$(tsess_dir)'"
}

tsess_attach() {
	local selected name dir
	local command="$1"

	if [[ -z "$command" ]]; then
		selected=$(
			column -t -s $'\t' "$(tsess_dir)" 2>/dev/null | \
			fzf \
				--prompt="tsess > " \
				--layout reverse \
				--height 40% \
		)
		name=$(echo $selected | awk '{print $1}')
	elif [[ "$command" == "attach" ]]; then
		name="$2"
	else
		name="$1"
	fi	

	dir=$(grep "^$name	" "$(tsess_dir)" | awk '{print $2}')

	if [[ -z "$name" || -z "$dir" ]]; then
		echo "No session selected"
		return 1
	fi

	dir=${~dir}
	dir=${dir:A}

	if tmux has-session -t $name 2>/dev/null; then
		tmux attach -t "$name"
	else
		tmux new -s "$name" -c "$dir"
	fi
}

tsess_help() {
	{
		echo "Usage: tsess <command>"
		echo "Commands:"
		echo "  add <name> <dir>	Add a new session"
		echo "  remove <name>	Remove a session"
		echo "  attach <name>	Attach to a session"
		echo "  help	Show this help message"
	} | column -t -s $'\t'
}

alias ts='tsess'
